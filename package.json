{
  "name": "qa-cypress-cucumber",
  "version": "1.0.0",
  "description": "Framework de automação Cypress + Cucumber",
  "main": "index.js",
  "scripts": {
  "cy:open": "cypress open",
  "cy:run": "cypress run",
  "report": "node scripts/generate-report.mjs",
  "api:evidence": "node scripts/capture-api-evidencias.mjs",
  "upload:xray": "node scripts/upload-xray.mjs",
  "test": "npm run cy:run && npm run report"
},

  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^25.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.5",
    "cypress": "15.17.0",
    "dotenv": "^17.2.3",
    "multiple-cucumber-html-reporter": "^3.9.3"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/step_definitions/**/*.js"
    ],
    "json": {
      "enabled": true,
      "output": "cypress/reports/json/cucumber-report.json"
    }
  }
}